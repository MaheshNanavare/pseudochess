{
  "name": "pseudochess",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "PseudoChess: reverse chess with forced captures. Lose your pieces to win.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit -p tsconfig.json",
    "icons": "tsx scripts/generate-icons.ts",
    "ui:smoke": "tsx scripts/ui-smoke.ts",
    "bench": "tsx scripts/bench.ts",
    "selfplay": "tsx scripts/selfplay.ts",
    "tune": "tsx scripts/tune.ts",
    "screenshots": "tsx scripts/capture-screenshots.ts"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "chess.js": "^1.4.0",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.2"
  }
}
